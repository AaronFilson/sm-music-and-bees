---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Contact & Booking | Sweet Marilyn" description="Get in touch with Sweet Marilyn for music booking, honey drops, wholesale inquiries, or apiary workshops.">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <!-- Header -->
    <div class="text-center max-w-xl mx-auto mb-12">
      <span class="text-xs uppercase tracking-widest text-slate-500 font-sans font-semibold">Connect</span>
      <h1 class="text-4xl sm:text-5xl font-heading text-slate-900 mt-2">Get in Touch</h1>
      <p class="mt-4 text-base text-stone-600 font-serif">
        We would love to hear from you. For booking, honey releases, wholesale orders, and workshop inquiries.
      </p>
    </div>

    <!-- Contact Info Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-12 font-sans">
      <div class="bg-white p-6 rounded-2xl border border-stone-200 shadow-sm text-center sm:text-left">
        <h3 class="text-sm font-semibold text-slate-900 uppercase tracking-wide">Direct Email</h3>
        <p class="text-xs text-stone-500 mt-1">Booking, press &amp; general inquiries</p>
        <a href="mailto:info@sweetmarilyn.org" class="mt-4 inline-block text-amber-700 font-medium hover:underline">
          info@sweetmarilyn.org
        </a>
      </div>

      <div class="bg-white p-6 rounded-2xl border border-stone-200 shadow-sm text-center sm:text-left">
        <h3 class="text-sm font-semibold text-slate-900 uppercase tracking-wide">Location</h3>
        <p class="text-xs text-stone-500 mt-1">Based in the Pacific Northwest</p>
        <p class="mt-4 text-stone-800 font-medium">
          Tacoma, Washington
        </p>
      </div>
    </div>

    <!-- Newsletter Signup Form (Clean, working HTML static form) -->
    <div class="bg-white p-8 sm:p-10 rounded-2xl border border-stone-200 shadow-sm">
      <h2 class="text-2xl font-heading text-slate-900 mb-2">Join the Sweet Marilyn Mailing List</h2>
      <p class="text-sm text-stone-600 font-serif mb-6">
        Sign up for early access to limited-release honey drops, upcoming concert announcements, and exclusive merchandise. No spam, ever.
      </p>

      <form action="mailto:info@sweetmarilyn.org" method="post" enctype="text/plain" class="space-y-4 font-sans">
        <div>
          <label for="name" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1">Your Name</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            placeholder="Jane Doe"
            class="w-full rounded-lg border border-stone-300 px-4 py-2.5 text-sm text-slate-900 focus:border-amber-600 focus:ring-1 focus:ring-amber-600 outline-none"
          />
        </div>

        <div>
          <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1">Email Address</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="you@example.com"
            class="w-full rounded-lg border border-stone-300 px-4 py-2.5 text-sm text-slate-900 focus:border-amber-600 focus:ring-1 focus:ring-amber-600 outline-none"
          />
        </div>

        <div>
          <label for="interest" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1">What are you most excited about?</label>
          <select
            id="interest"
            name="interest"
            class="w-full rounded-lg border border-stone-300 px-4 py-2.5 text-sm text-slate-900 focus:border-amber-600 focus:ring-1 focus:ring-amber-600 outline-none bg-white"
          >
            <option value="both">Both Music and Honey Drops</option>
            <option value="music">Live Shows &amp; New Music</option>
            <option value="honey">Raw Honey &amp; Bee Boxes</option>
            <option value="experiences">Hive Tours &amp; Workshops</option>
          </select>
        </div>

        <div class="pt-2">
          <button
            type="submit"
            class="w-full rounded-lg bg-slate-900 py-3 px-6 text-sm font-semibold text-white transition hover:bg-slate-800 shadow-sm"
          >
            Subscribe for Updates &rarr;
          </button>
        </div>
      </form>
    </div>

  </div>
</Layout>
