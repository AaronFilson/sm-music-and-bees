---
import Layout from '../layouts/Layout.astro';
import ClientPreviewBar from '../components/ClientPreviewBar.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import Bandsintown from '../components/Bandsintown.astro';
import SquareProduct from '../components/SquareProduct.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Idea 2: The Mode Switcher | Sweet Marilyn Design Concepts">
  <ClientPreviewBar currentIdea="2" />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Concept Explanation Header -->
    <div class="mt-6 mb-8 rounded-xl bg-indigo-50/80 border border-indigo-200 p-4 text-xs font-sans text-stone-700 flex flex-col md:flex-row md:items-center justify-between gap-3">
      <div>
        <span class="font-bold text-indigo-900 uppercase tracking-wide">Design Concept 2: The Hive &amp; Stage Mode Switcher</span>
        <p class="text-stone-600 mt-0.5">Interactive focus filter: Lets the visitor switch the entire website between Harmonized, Music-First, or Honey-First experiences in real-time.</p>
      </div>
      <span class="px-2.5 py-1 rounded bg-indigo-200/70 text-indigo-900 font-semibold text-[11px] self-start md:self-auto">
        Dynamic &amp; Interactive
      </span>
    </div>

    <!-- Interactive Mode Switcher Bar -->
    <div class="flex items-center justify-center mb-10">
      <div class="inline-flex rounded-2xl bg-stone-200/80 p-1.5 shadow-inner border border-stone-300 font-sans text-sm font-medium">
        <button id="toggle-all" onclick="setMode('all')" class="mode-btn active rounded-xl px-5 py-2.5 transition shadow-sm bg-white text-slate-900 font-semibold">
          ◈ Harmonized
        </button>
        <button id="toggle-music" onclick="setMode('music')" class="mode-btn rounded-xl px-5 py-2.5 transition text-stone-700 hover:text-slate-900">
          🎵 Music &amp; Shows
        </button>
        <button id="toggle-honey" onclick="setMode('honey')" class="mode-btn rounded-xl px-5 py-2.5 transition text-stone-700 hover:text-slate-900">
          🍯 Apiary &amp; Honey
        </button>
      </div>
    </div>

    <!-- Dynamic Hero -->
    <section class="grid grid-cols-1 gap-10 py-8 lg:grid-cols-12 lg:items-center lg:gap-14 border-b border-stone-200 pb-14 transition-all duration-300">
      <div class="lg:col-span-5">
        <div class="aspect-[4/5] overflow-hidden rounded-2xl bg-stone-100 shadow-sm border border-stone-200 relative">
          <img
            id="hero-img-all"
            alt="Sweet Marilyn - Jade Monroe"
            class="hero-img h-full w-full object-cover object-center transition duration-500"
            src={`${base}/images/band_portrait_1.jpg`}
          />
          <img
            id="hero-img-music"
            alt="Sweet Marilyn Live"
            class="hero-img hidden h-full w-full object-cover object-center transition duration-500"
            src={`${base}/images/band_portrait_2.jpg`}
          />
          <img
            id="hero-img-honey"
            alt="Jade Monroe Beekeeper"
            class="hero-img hidden h-full w-full object-cover object-center transition duration-500"
            src={`${base}/images/beekeeper_portrait.jpg`}
          />
          <div id="hero-badge" class="absolute bottom-3 left-3 bg-slate-900/80 backdrop-blur-sm text-white text-xs px-3 py-1 rounded-full font-sans">
            Jade Monroe • Musician &amp; Beekeeper
          </div>
        </div>
      </div>

      <div class="flex flex-col justify-center lg:col-span-7">
        <span id="hero-kicker" class="text-xs uppercase tracking-widest text-amber-700 font-sans font-semibold">
          Tacoma, Washington
        </span>

        <h2 id="hero-title" class="mt-2 text-4xl font-normal leading-tight tracking-tight text-slate-900 sm:text-5xl font-heading">
          Hello &amp; Welcome
        </h2>

        <div id="hero-text-all" class="hero-text mt-6 space-y-4 text-base leading-relaxed text-stone-700 font-serif">
          <p>
            Welcome to <strong>Sweet Marilyn</strong>. We are an art rock collective and sustainable urban apiary in Tacoma, led by songwriter and beekeeper <strong>Jade Monroe</strong>.
          </p>
          <p>
            Experience our dynamic, evocative live performances, and explore our small-batch raw honey harvested directly from treatment-free neighborhood hives.
          </p>
        </div>

        <div id="hero-text-music" class="hero-text hidden mt-6 space-y-4 text-base leading-relaxed text-stone-700 font-serif">
          <p>
            <strong>Sweet Marilyn</strong> is dynamic Pacific Northwest art rock. Led by Jade Monroe's powerful Kate Bush-style howl, soaring melodic hooks, and lush instrumentation.
          </p>
          <p>
            Catch our upcoming tour dates via Bandsintown, stream our Bandcamp discography, or listen to exclusive live broadcast sessions recorded at KAOS and Cider &amp; Cedar.
          </p>
        </div>

        <div id="hero-text-honey" class="hero-text hidden mt-6 space-y-4 text-base leading-relaxed text-stone-700 font-serif">
          <p>
            <strong>Sweet Marilyn Honey</strong> is pure, unpasteurized, treatment-free urban honey cultivated by Jade Monroe in backyard apiaries across Tacoma, WA.
          </p>
          <p>
            Each seasonal release reflects local Salish Sea floral terroir—wild Himalayan blackberry, fireweed, and Douglas fir honeydew. Hand-spun in small batches with zero additives.
          </p>
        </div>

        <!-- Mode Specific Action Buttons -->
        <div class="mt-8 flex flex-wrap gap-4 font-sans text-sm font-medium">
          <div id="actions-all" class="mode-actions flex flex-wrap gap-4">
            <button onclick="setMode('music')" class="rounded-lg bg-slate-900 px-6 py-3 text-white transition hover:bg-slate-800 shadow-sm">
              Focus on Music &amp; Shows &rarr;
            </button>
            <button onclick="setMode('honey')" class="rounded-lg border border-amber-600/40 bg-amber-50 px-6 py-3 text-amber-900 transition hover:bg-amber-100 shadow-sm">
              Focus on Apiary &amp; Honey &rarr;
            </button>
          </div>

          <div id="actions-music" class="mode-actions hidden flex flex-wrap gap-4">
            <a href="#music-block" class="rounded-lg bg-slate-900 px-6 py-3 text-white transition hover:bg-slate-800 shadow-sm">
              View Tour Dates &amp; Stream &rarr;
            </a>
            <button onclick="setMode('all')" class="rounded-lg border border-stone-300 bg-white px-6 py-3 text-stone-700 transition hover:bg-stone-50">
              Return to Full View
            </button>
          </div>

          <div id="actions-honey" class="mode-actions hidden flex flex-wrap gap-4">
            <a href="#honey-block" class="rounded-lg bg-amber-600 px-6 py-3 text-white transition hover:bg-amber-700 shadow-sm">
              Order Honey via Square &rarr;
            </a>
            <button onclick="setMode('all')" class="rounded-lg border border-stone-300 bg-white px-6 py-3 text-stone-700 transition hover:bg-stone-50">
              Return to Full View
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Music Section Block -->
    <section id="music-block" class="py-10 transition-all duration-300">
      <div class="border-b border-stone-200 pb-4 mb-8 flex justify-between items-end">
        <div>
          <span class="text-xs uppercase tracking-widest text-slate-500 font-sans font-semibold">Sound &amp; Stage</span>
          <h2 class="text-3xl font-heading text-slate-900 mt-1">Live Frequencies &amp; Tour Dates</h2>
        </div>
        <a href="https://sweetmarilyn.bandcamp.com/" target="_blank" class="text-xs font-sans text-amber-700 hover:underline">
          Bandcamp Discography &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
        <AudioPlayer />
        <Bandsintown artistName="Sweet Marilyn" />
      </div>

      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-white p-6 rounded-2xl border border-stone-200 shadow-sm">
          <h3 class="text-lg font-heading text-slate-900 mb-2">Hidden Springs (Bandcamp Album)</h3>
          <iframe
            style="border: 0; width: 100%; height: 120px;"
            src="https://bandcamp.com/EmbeddedPlayer/album=2109830179/size=large/bgcol=ffffff/linkcol=C67C26/tracklist=false/artwork=small/transparent=true/"
            seamless
          >
            <a href="https://sweetmarilyn.bandcamp.com/album/hidden-springs">Hidden Springs by Sweet Marilyn</a>
          </iframe>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-stone-200 shadow-sm">
          <h3 class="text-lg font-heading text-slate-900 mb-2">&ldquo;Aliens&rdquo; Music Video</h3>
          <div class="aspect-video w-full rounded-xl overflow-hidden bg-black">
            <iframe
              class="w-full h-full"
              src="https://www.youtube.com/embed/0q1E-IzC7QU"
              title="Aliens Video"
              frameborder="0"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      </div>
    </section>

    <!-- Apiary & Honey Section Block -->
    <section id="honey-block" class="py-10 transition-all duration-300">
      <div class="border-b border-stone-200 pb-4 mb-8 flex justify-between items-end">
        <div>
          <span class="text-xs uppercase tracking-widest text-amber-700 font-sans font-semibold">The Hive &amp; Harvest</span>
          <h2 class="text-3xl font-heading text-slate-900 mt-1">Raw Honey Drops &amp; Experiences</h2>
        </div>
        <span class="text-xs font-sans text-stone-500">Square Store Integration</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <SquareProduct
          title="6 oz Raw Honey Jar"
          price="$30.00"
          description="Single-harvest, unfiltered Pacific Northwest wildflower and blackberry honey. Hand-spun in small seasonal batches."
          image={`${base}/images/honey_jar.jpg`}
          badge="Limited Drop"
          buyUrl="https://sweetmarilyn.square.site/"
        />

        <SquareProduct
          title="Holiday Bee Box"
          price="$55.00"
          description="Curated winter gift set including our seasonal honey jar, handcrafted beeswax tea lights, and a digital album download code."
          image={`${base}/images/beekeeper_hive.jpg`}
          badge="Seasonal Release"
          buyUrl="https://sweetmarilyn.square.site/"
        />

        <SquareProduct
          title="Tacoma Hive Tour"
          price="$75.00"
          description="Suit up and join Jade for a 90-minute live hive inspection. Includes protective gear, honey tasting flight, and pollinator ecology discussion."
          image={`${base}/images/beekeeper_portrait.jpg`}
          badge="Workshop"
          buyUrl="https://sweetmarilyn.square.site/"
        />
      </div>
    </section>

  </div>

  <!-- Client-side Mode Switcher Logic -->
  <script is:inline>
    function setMode(mode) {
      // Toggle button states
      document.querySelectorAll('.mode-btn').forEach(btn => {
        btn.classList.remove('bg-white', 'text-slate-900', 'font-semibold', 'shadow-sm');
        btn.classList.add('text-stone-700');
      });
      const activeBtn = document.getElementById('toggle-' + mode);
      if (activeBtn) {
        activeBtn.classList.add('bg-white', 'text-slate-900', 'font-semibold', 'shadow-sm');
        activeBtn.classList.remove('text-stone-700');
      }

      // Hide all images, texts, actions
      document.querySelectorAll('.hero-img').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.hero-text').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.mode-actions').forEach(el => el.classList.add('hidden'));

      // Show selected mode elements
      const targetImg = document.getElementById('hero-img-' + mode);
      if (targetImg) targetImg.classList.remove('hidden');

      const targetText = document.getElementById('hero-text-' + mode);
      if (targetText) targetText.classList.remove('hidden');

      const targetActions = document.getElementById('actions-' + mode);
      if (targetActions) targetActions.classList.remove('hidden');

      // Update titles / badges
      const kicker = document.getElementById('hero-kicker');
      const title = document.getElementById('hero-title');
      const badge = document.getElementById('hero-badge');
      const musicBlock = document.getElementById('music-block');
      const honeyBlock = document.getElementById('honey-block');

      if (mode === 'all') {
        kicker.innerText = 'Tacoma, Washington';
        title.innerText = 'Hello & Welcome';
        badge.innerText = 'Jade Monroe • Musician & Beekeeper';
        musicBlock.classList.remove('hidden');
        honeyBlock.classList.remove('hidden');
      } else if (mode === 'music') {
        kicker.innerText = 'Art Rock Collective • Tacoma';
        title.innerText = 'Sound, Frequency & Stage';
        badge.innerText = 'Sweet Marilyn • Live Frequencies';
        musicBlock.classList.remove('hidden');
        honeyBlock.classList.add('hidden');
      } else if (mode === 'honey') {
        kicker.innerText = 'Sustainable Urban Apiculture';
        title.innerText = 'Pure Raw Urban Honey';
        badge.innerText = 'Sweet Marilyn Apiary • Single-Harvest';
        musicBlock.classList.add('hidden');
        honeyBlock.classList.remove('hidden');
      }
    }
  </script>
</Layout>
