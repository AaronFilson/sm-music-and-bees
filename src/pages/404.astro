---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Page Not Found | Sweet Marilyn" description="We couldn't find that page on Sweet Marilyn.">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center">
    <span class="text-xs uppercase tracking-widest text-amber-700 font-sans font-semibold">404 &bull; Lost in the Wildflowers</span>
    <h1 class="mt-3 text-4xl sm:text-5xl font-heading text-slate-900">Page Not Found</h1>
    <p class="mt-4 text-base text-stone-600 font-serif leading-relaxed">
      The page you’re looking for may have moved or hasn’t bloomed yet. Let’s guide you back to the music or the apiary.
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-4 font-sans text-sm font-medium">
      <a
        href={`${base}/`}
        class="rounded-lg bg-slate-900 px-6 py-3 text-white transition hover:bg-slate-800 shadow-sm"
      >
        Return Home &rarr;
      </a>
      <a
        href={`${base}/music`}
        class="rounded-lg border border-stone-300 bg-white px-6 py-3 text-slate-700 transition hover:bg-stone-50 shadow-sm"
      >
        Music &amp; Shows
      </a>
      <a
        href={`${base}/honey`}
        class="rounded-lg border border-amber-600/40 bg-amber-50 px-6 py-3 text-amber-900 transition hover:bg-amber-100 shadow-sm"
      >
        The Apiary &amp; Honey
      </a>
    </div>
  </div>
</Layout>
