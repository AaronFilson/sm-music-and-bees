---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

import jadePortrait from '../assets/images/jade_monroe_portrait.jpg';
import bandGroup3 from '../assets/images/band_group_3.jpg';
import beekeeperHive from '../assets/images/beekeeper_hive.jpg';
---

<Layout title="About Sweet Marilyn | Art Rock & Raw Honey" description="Meet Jade Monroe, the musician and beekeeper behind Sweet Marilyn in Tacoma, Washington.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-xs uppercase tracking-widest text-slate-500 font-sans font-semibold">The Story</span>
      <h1 class="text-4xl sm:text-5xl font-heading text-slate-900 mt-2">About Sweet Marilyn</h1>
    </div>

    <!-- Main Bio Article -->
    <article class="bg-white p-8 sm:p-12 rounded-2xl border border-stone-200 shadow-sm space-y-8 text-stone-700 font-serif text-lg leading-relaxed">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
        <figure class="md:col-span-5 max-w-sm mx-auto w-full">
          <div class="aspect-[3/4] w-full overflow-hidden rounded-xl bg-stone-100 border border-stone-200 shadow-sm">
            <Image
              src={jadePortrait}
              widths={[480, 800]}
              sizes="(max-width: 768px) 384px, 340px"
              loading="eager"
              fetchpriority="high"
              alt="Jade Monroe at Port Wilson Lighthouse"
              class="w-full h-full object-cover object-center"
            />
          </div>
          <figcaption class="mt-2 text-xs text-stone-400 font-sans text-center">
            Jade Monroe at Port Wilson Lighthouse &bull; Photo by @scios.photo
          </figcaption>
        </figure>

        <div class="md:col-span-7 space-y-5">
          <h2 class="text-3xl font-heading text-slate-900">Two Disciplines, One Creative Ecosystem</h2>
          
          <p>
            Sweet Marilyn began as the musical project of Tacoma singer, guitarist, and songwriter <strong>Jade Monroe</strong>. Known for dynamic songwriting that oscillates between gentle folk melodies and roaring art-rock climaxes, Monroe has earned praise across Pacific Northwest radio stations like KNKX and KAOS for her expressive, emotive vocal range.
          </p>

          <p>
            Parallel to music, Jade found a second calling in urban apiculture. What started as one backyard hive grew into a dedicated community practice: keeping treatment-free European honeybees, educating neighbors about urban pollinator habitat, and harvesting small batches of raw honey that honor the local ecosystem.
          </p>
        </div>
      </div>

      <div class="p-6 bg-stone-50 rounded-xl border-l-4 border-amber-600">
        <p class="italic text-base text-stone-800">
          &ldquo;Bees work in deep, collective rhythm. A hive vibrates at specific frequencies to communicate, regulate heat, and build honeycomb. To me, music and beekeeping are mirror crafts: they both require active listening, patience, and honoring the frequency of living things.&rdquo;
        </p>
        <span class="block text-xs font-sans not-italic font-medium text-stone-500 mt-2 uppercase tracking-wide">&mdash; Jade Monroe</span>
      </div>

      <p>
        Today, Sweet Marilyn brings together both passions under one roof. When you purchase Sweet Marilyn honey, attend an apiary tour, or stream our records, you are supporting a self-sustaining, community-rooted artist operating with authenticity in Tacoma, WA.
      </p>

      <!-- Photos Gallery -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4">
        <div class="aspect-[4/3] rounded-xl overflow-hidden bg-stone-100">
          <Image
            src={bandGroup3}
            widths={[400, 720]}
            sizes="(max-width: 640px) 100vw, 400px"
            alt="Sweet Marilyn Live Guitar"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="aspect-[4/3] rounded-xl overflow-hidden bg-stone-100">
          <Image
            src={beekeeperHive}
            widths={[400, 720]}
            sizes="(max-width: 640px) 100vw, 400px"
            alt="Beekeeping with Sweet Marilyn"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </article>

  </div>
</Layout>
