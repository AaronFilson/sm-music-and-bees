---
import Layout from '../layouts/Layout.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import Bandsintown from '../components/Bandsintown.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Music & Shows | Sweet Marilyn" description="Sweet Marilyn art rock discography, live shows, Bandcamp releases, and tour dates in Tacoma and beyond.">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-xs uppercase tracking-widest text-slate-500 font-sans font-semibold">Sound &amp; Performance</span>
      <h1 class="text-4xl sm:text-5xl font-heading text-slate-900 mt-2">Music &amp; Live Shows</h1>
      <p class="mt-4 text-base text-stone-600 font-serif">
        Indie art rock infused with melodic hooks, rhythmic drive, and soaring vocals. Based in Tacoma, Washington.
      </p>
    </div>

    <!-- Live Tour Dates Inset -->
    <section class="mb-14">
      <Bandsintown />
    </section>

    <!-- Bandcamp Releases Grid -->
    <section class="mb-14">
      <div class="border-b border-stone-200 pb-4 mb-8">
        <h2 class="text-2xl font-heading text-slate-900">Discography on Bandcamp</h2>
        <p class="text-xs text-stone-500 font-sans">Stream full length albums or buy high quality downloads</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-white p-6 rounded-2xl border border-stone-200 shadow-sm">
          <h3 class="text-lg font-heading text-slate-900 mb-2">Hidden Springs</h3>
          <p class="text-xs text-stone-500 font-sans mb-4">Released 2024 • Studio EP</p>
          <iframe
            title="Hidden Springs by Sweet Marilyn on Bandcamp"
            loading="lazy"
            class="border-0 w-full h-[350px]"
            src="https://bandcamp.com/EmbeddedPlayer/album=2109830179/size=large/bgcol=ffffff/linkcol=C67C26/tracklist=true/transparent=true/"
          >
            <a href="https://sweetmarilyn.bandcamp.com/album/hidden-springs">Hidden Springs by Sweet Marilyn</a>
          </iframe>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-stone-200 shadow-sm">
          <h3 class="text-lg font-heading text-slate-900 mb-2">Live at Cider and Cedar</h3>
          <p class="text-xs text-stone-500 font-sans mb-4">Released 2025 • Live Concert Recording</p>
          <iframe
            title="Live at Cider and Cedar by Sweet Marilyn on Bandcamp"
            loading="lazy"
            class="border-0 w-full h-[350px]"
            src="https://bandcamp.com/EmbeddedPlayer/album=91042147/size=large/bgcol=ffffff/linkcol=C67C26/tracklist=true/transparent=true/"
          >
            <a href="https://sweetmarilyn.bandcamp.com/album/live-at-cider-and-cedar">Live at Cider and Cedar by Sweet Marilyn</a>
          </iframe>
        </div>
      </div>
    </section>

    <!-- Direct Audio Master Recordings -->
    <section class="mb-14">
      <AudioPlayer />
    </section>

    <!-- Music Video Feature -->
    <section class="mb-14">
      <div class="bg-white p-6 sm:p-8 rounded-2xl border border-stone-200 shadow-sm">
        <h2 class="text-2xl font-heading text-slate-900 mb-2">&ldquo;Aliens&rdquo; Music Video</h2>
        <p class="text-xs text-stone-500 font-sans mb-6">Official music video by Sweet Marilyn</p>
        <div class="aspect-video w-full overflow-hidden rounded-xl bg-black">
          <iframe
            class="h-full w-full border-0"
            loading="lazy"
            src="https://www.youtube.com/embed/0q1E-IzC7QU"
            title="Sweet Marilyn - Aliens Official Video"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </section>

    <!-- Booking CTA Banner -->
    <div class="rounded-2xl bg-stone-200/80 p-8 text-center border border-stone-300">
      <h3 class="text-2xl font-heading text-slate-900">For Booking &amp; Show Inquiries</h3>
      <p class="mt-2 text-sm text-stone-700 max-w-lg mx-auto">
        Sweet Marilyn is available for festival appearances, venue performances, acoustic sessions, and collaborative events.
      </p>
      <div class="mt-6">
        <a href={`${base}/contact`} class="inline-block rounded-lg bg-slate-900 px-6 py-3 text-sm font-medium text-white transition hover:bg-slate-800 font-sans shadow-sm">
          Get in Touch &rarr;
        </a>
      </div>
    </div>

  </div>
</Layout>
