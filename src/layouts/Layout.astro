---
import { Image } from 'astro:assets';
import '../styles/global.css';
import ClientPreviewBar from '../components/ClientPreviewBar.astro';
import logoImg from '../assets/images/logo.png';

interface Props {
  title?: string;
  description?: string;
  previewIdea?: '1' | '2' | '3' | '4';
  minimalChrome?: boolean;
}

const {
  title = "Sweet Marilyn | Art Rock & Raw Honey | Tacoma, WA",
  description = "Original art rock and sustainable raw urban honey cultivated by Jade Monroe in Tacoma, Washington. Live shows, Bandcamp releases, and small-batch honey drops.",
  previewIdea,
  minimalChrome = false
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = Astro.url.pathname;
const canonicalUrl = new URL(pathname, Astro.site).href;
const ogImageUrl = new URL(`${base}/images/og-cover.jpg`, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="64x64" href={`${base}/favicon.png`} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=PT+Serif:ital,wght@0,400;0,700;1,400;1,700&display=swap"
      rel="stylesheet"
    />
    <meta property="og:site_name" content="Sweet Marilyn" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
  </head>
  <body class="min-h-screen bg-[#FAF9F6] text-slate-850 antialiased flex flex-col font-serif">
    <ClientPreviewBar currentIdea={previewIdea} isSubpage={!previewIdea} />

    {!minimalChrome && (
      <>
        <!-- Top Musician & Beekeeper Banner (Brady McCowan style) -->
        <section class="flex flex-col items-center justify-center bg-stone-200 border-b border-stone-300 px-4 py-6 text-center sm:py-8">
          <a href={`${base}/`} class="inline-block transition hover:opacity-90">
            <p class="text-3xl font-normal tracking-tight text-slate-900 sm:text-5xl font-heading">
              Sweet Marilyn
            </p>
          </a>
          <p class="mt-1 text-xs tracking-widest uppercase text-stone-700 sm:text-sm font-sans font-medium">
            Art Rock &amp; Raw Honey &bull; Tacoma, Washington
          </p>
        </section>

        <!-- Navigation Header -->
        <header class="sticky top-0 z-40 border-b border-stone-200 bg-[#FAF9F6]/95 backdrop-blur-md">
          <nav aria-label="Primary" class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 px-4 py-3 text-sm sm:gap-x-10 sm:px-8 sm:py-4 sm:text-base font-sans">
            <a href={`${base}/`} class={`transition hover:text-amber-600 ${pathname === `${base}/` || pathname === `${base}` ? 'text-amber-700 font-semibold' : 'text-slate-700'}`}>Home</a>
            <a href={`${base}/music`} class={`transition hover:text-amber-600 ${pathname.includes('/music') ? 'text-amber-700 font-semibold' : 'text-slate-700'}`}>Music &amp; Shows</a>
            <a href={`${base}/honey`} class={`transition hover:text-amber-600 ${pathname.includes('/honey') ? 'text-amber-700 font-semibold' : 'text-slate-700'}`}>The Apiary &amp; Honey</a>
            <a href={`${base}/experiences`} class={`transition hover:text-amber-600 ${pathname.includes('/experiences') ? 'text-amber-700 font-semibold' : 'text-slate-700'}`}>Experiences</a>
            <a href={`${base}/about`} class={`transition hover:text-amber-600 ${pathname.includes('/about') ? 'text-amber-700 font-semibold' : 'text-slate-700'}`}>About</a>
            <a href={`${base}/contact`} class={`transition hover:text-amber-600 ${pathname.includes('/contact') ? 'text-amber-700 font-semibold' : 'text-slate-700'}`}>Contact</a>
          </nav>
        </header>
      </>
    )}

    <!-- Main Content Slot -->
    <main class="w-full flex-1">
      <slot />
    </main>

    {!minimalChrome && (
      <footer class="mt-20 border-t border-stone-300 bg-stone-100 py-12 px-6 sm:px-12">
        <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center justify-between gap-8 text-center md:text-left">
          <div class="flex flex-col items-center md:items-start">
            <div class="flex items-center gap-3">
              <Image src={logoImg} width={160} alt="Sweet Marilyn Logo" class="h-10 w-auto opacity-90" />
              <span class="text-xl font-heading text-slate-900">Sweet Marilyn</span>
            </div>
            <p class="mt-2 text-sm text-stone-600 max-w-sm">
              Sustainable urban beekeeping and dynamic art rock based in Tacoma, Washington. Cultivated with intention by Jade Monroe.
            </p>
          </div>

          <div class="flex flex-col items-center md:items-end gap-3 text-sm font-sans">
            <div class="flex flex-wrap justify-center gap-6 text-slate-700">
              <a href="https://sweetmarilyn.bandcamp.com/" target="_blank" rel="noopener noreferrer" class="hover:text-amber-600 transition">Bandcamp</a>
              <a href="https://www.instagram.com/sweetmarilyn.xo/" target="_blank" rel="noopener noreferrer" class="hover:text-amber-600 transition">Instagram</a>
              <a href="https://www.youtube.com/@SweetMarilyn-xoxo" target="_blank" rel="noopener noreferrer" class="hover:text-amber-600 transition">YouTube</a>
              <a href="https://www.facebook.com/SweetMarilyn.xo" target="_blank" rel="noopener noreferrer" class="hover:text-amber-600 transition">Facebook</a>
            </div>
            <p class="text-xs text-stone-500">
              For booking &amp; inquiries: <a href="mailto:info@sweetmarilyn.org" class="underline hover:text-slate-900">info@sweetmarilyn.org</a>
            </p>
            <p class="text-xs text-stone-400 mt-2">
              &copy; {new Date().getFullYear()} Sweet Marilyn. All rights reserved.
            </p>
          </div>
        </div>
      </footer>
    )}
  </body>
</html>
