---
interface Props {
  artistName?: string;
}

const { artistName = "Sweet Marilyn" } = Astro.props;
---

<div class="bandsintown-widget-container w-full rounded-2xl bg-white p-6 shadow-sm border border-stone-200">
  <div class="flex items-center justify-between pb-4 border-b border-stone-100">
    <div>
      <h3 class="text-xl font-heading text-slate-900">Upcoming Live Shows</h3>
      <p class="text-xs text-stone-500 font-sans">Synced automatically via Bandsintown</p>
    </div>
    <span class="inline-flex items-center rounded-full bg-amber-50 px-3 py-1 text-xs font-medium text-amber-700 border border-amber-200">
      Live Dates
    </span>
  </div>

  <div class="mt-4">
    <!-- Bandsintown official embed -->
    <script charset="utf-8" src="https://widget.bandsintown.com/main.min.js"></script>
    <a class="bit-widget-initializer"
       data-artist-name={artistName}
       data-auto-style="false"
       data-text-color="#1E293B"
       data-link-color="#C67C26"
       data-background-color="rgba(0,0,0,0)"
       data-display-limit="6"
       data-display-past-dates="false"
       data-display-local-dates="false">
    </a>

    <!-- Fallback / Static preview if no upcoming dates currently published in widget -->
    <noscript>
      <div class="py-6 text-center text-sm text-stone-500 font-sans">
        Enable JavaScript to view live tour dates, or follow Sweet Marilyn on <a href="https://www.bandsintown.com/a/15535747-sweet-marilyn" target="_blank" class="underline text-amber-600">Bandsintown</a>.
      </div>
    </noscript>
  </div>
</div>
