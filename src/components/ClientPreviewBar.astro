---
interface Props {
  currentIdea: '1' | '2' | '3';
}

const { currentIdea } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="bg-slate-900 text-white px-4 py-2.5 text-xs font-sans flex flex-wrap items-center justify-between gap-3 sticky top-0 z-50 shadow-md">
  <div class="flex items-center gap-2">
    <span class="inline-block w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse"></span>
    <span class="font-bold text-amber-300 uppercase tracking-wider">Client Presentation Mode:</span>
    <span class="text-stone-300 hidden sm:inline">Compare the 3 approaches to harmonize Bees &amp; Music</span>
  </div>
  
  <div class="flex items-center gap-1.5 bg-slate-800 p-1 rounded-lg border border-slate-700">
    <a
      href={`${base}/idea-1`}
      class={`px-3 py-1 rounded-md transition font-medium ${currentIdea === '1' ? 'bg-amber-600 text-white font-bold' : 'text-stone-300 hover:text-white hover:bg-slate-700'}`}
    >
      Idea 1: Dual-Pillar
    </a>
    <a
      href={`${base}/idea-2`}
      class={`px-3 py-1 rounded-md transition font-medium ${currentIdea === '2' ? 'bg-amber-600 text-white font-bold' : 'text-stone-300 hover:text-white hover:bg-slate-700'}`}
    >
      Idea 2: Mode Switcher
    </a>
    <a
      href={`${base}/idea-3`}
      class={`px-3 py-1 rounded-md transition font-medium ${currentIdea === '3' ? 'bg-amber-600 text-white font-bold' : 'text-stone-300 hover:text-white hover:bg-slate-700'}`}
    >
      Idea 3: Resonance &amp; Nectar
    </a>
  </div>
</div>
