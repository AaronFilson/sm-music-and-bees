---
interface Props {
  currentIdea?: '1' | '2' | '3';
  isSubpage?: boolean;
}

const { currentIdea, isSubpage = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div
  id="client-preview-bar"
  data-is-subpage={isSubpage ? 'true' : 'false'}
  class={`bg-slate-900 text-white px-4 py-2.5 text-xs font-sans flex flex-wrap items-center justify-between gap-3 border-b border-slate-800 ${isSubpage ? 'hidden' : ''}`}
>
  <div class="flex items-center gap-2">
    <span class="inline-block w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse"></span>
    <span class="font-bold text-amber-300 uppercase tracking-wider">Client Presentation Mode:</span>
    <span class="text-stone-300 hidden md:inline">Compare the 3 approaches to harmonize Bees &amp; Music</span>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <div class="flex items-center gap-1.5 bg-slate-800 p-1 rounded-lg border border-slate-700">
      <a
        href={`${base}/idea-1`}
        class={`px-3 py-1 rounded-md transition font-medium ${currentIdea === '1' ? 'bg-amber-600 text-white font-bold' : 'text-stone-300 hover:text-white hover:bg-slate-700'}`}
      >
        Idea 1: Dual-Pillar
      </a>
      <a
        href={`${base}/idea-2`}
        class={`px-3 py-1 rounded-md transition font-medium ${currentIdea === '2' ? 'bg-amber-600 text-white font-bold' : 'text-stone-300 hover:text-white hover:bg-slate-700'}`}
      >
        Idea 2: Mode Switcher
      </a>
      <a
        href={`${base}/idea-3`}
        class={`px-3 py-1 rounded-md transition font-medium ${currentIdea === '3' ? 'bg-amber-600 text-white font-bold' : 'text-stone-300 hover:text-white hover:bg-slate-700'}`}
      >
        Idea 3: Resonance &amp; Nectar
      </a>
    </div>

    <label
      for="subpage-preview-toggle"
      class="inline-flex items-center gap-2 cursor-pointer select-none pl-3 border-l border-slate-700 text-stone-300 hover:text-white transition"
      title="Show this concept switcher bar when browsing Music, Honey, Experiences, About, and Contact subpages"
    >
      <span class="text-[11px] font-medium">Show on subpages</span>
      <span class="relative inline-flex items-center">
        <input id="subpage-preview-toggle" type="checkbox" role="switch" class="sr-only peer" />
        <span class="w-9 h-5 bg-slate-700 rounded-full peer peer-focus-visible:ring-2 peer-focus-visible:ring-amber-400 peer-checked:bg-amber-600 transition-colors"></span>
        <span class="absolute left-0.5 top-0.5 w-4 h-4 bg-white rounded-full shadow-sm transition-transform peer-checked:translate-x-4"></span>
      </span>
    </label>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'sm_show_subpage_preview_bar';
    var bar = document.getElementById('client-preview-bar');
    var toggle = document.getElementById('subpage-preview-toggle');
    if (!bar || !toggle) return;
    var isSubpage = bar.getAttribute('data-is-subpage') === 'true';
    var enabled = false;
    try {
      enabled = localStorage.getItem(KEY) === 'true';
    } catch (e) {}
    toggle.checked = enabled;
    if (isSubpage && enabled) {
      bar.classList.remove('hidden');
    }
    toggle.addEventListener('change', function () {
      var next = !!toggle.checked;
      try {
        localStorage.setItem(KEY, next ? 'true' : 'false');
      } catch (e) {}
      if (isSubpage && !next) {
        bar.classList.add('hidden');
      }
    });
  })();
</script>
